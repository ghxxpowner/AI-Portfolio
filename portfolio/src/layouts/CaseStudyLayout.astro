---
import type { CollectionEntry } from 'astro:content';
import '../styles/prose.css';
import BaseLayout from './BaseLayout.astro';
import CaseStudyHero from '../components/CaseStudyHero.astro';
import CaseStudyStats from '../components/CaseStudyStats.astro';
import Pager from '../components/Pager.astro';

interface Props {
  entry: CollectionEntry<'work'>;
  prev?: CollectionEntry<'work'>;
  next?: CollectionEntry<'work'>;
}

const { entry, prev, next } = Astro.props;
---

<BaseLayout title={entry.data.title} description={entry.data.summary} type="article">
  <div class="reading-progress" aria-hidden="true"></div>
  <article class:list={['container', 'case-study', `case-study--${entry.id}`]}>
    <CaseStudyHero {entry} />
    <div class="at-a-glance" data-reveal>
      <h2 class="visually-hidden">At a glance</h2>
      <div data-reveal-item>
        <CaseStudyStats stats={entry.data.stats} />
      </div>
    </div>
    <div class="prose flow">
      <slot />
    </div>
    <Pager {prev} {next} />
  </article>
</BaseLayout>

<style>
  /* Reading progress — fills exactly the gap between the viewport top and the
     header pill, whose sticky offset is var(--space-sm). Purely decorative
     (aria-hidden), so hiding it entirely is the correct fallback: it is only
     shown where scroll-driven animation exists AND motion is welcome.
     z-index sits above .edge-fade (90) so the top blur never smears it, and
     below the header (100). */
  .reading-progress {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .reading-progress {
        display: block;
        position: fixed;
        inset-block-start: 0;
        inset-inline: 0;
        z-index: 95;
        block-size: var(--space-sm);
        pointer-events: none;
        background-color: var(--color-accent);
        transform-origin: left center;
        scale: 0 1;
        animation: reading-progress linear both;
        animation-timeline: scroll(root);
      }
    }
  }

  @keyframes reading-progress {
    to {
      scale: 1 1;
    }
  }

  .at-a-glance {
    margin-block-start: var(--space-xl);
  }

  .case-study :global(.prose) {
    margin-block-start: var(--space-2xl);
  }

  /* zdf-streaming-platform only: let the figure frames blend into the page
     background instead of sitting on lighter surface cards. */
  .case-study--zdf-streaming-platform :global(.figure-frame) {
    background-color: var(--color-bg);
  }

  /* zdf-streaming-platform only: this study is carried by its imagery, so its
     media get twice the vertical rhythm. Each media component sets
     `--flow-space: var(--space-xl)` itself; `.prose` is in the selector purely
     to outrank those component rules regardless of stylesheet order. Prose
     spacing is untouched — only the gaps around images change. */
  .case-study--zdf-streaming-platform :global(.prose .figure),
  .case-study--zdf-streaming-platform :global(.prose .mds),
  .case-study--zdf-streaming-platform :global(.prose .ps),
  .case-study--zdf-streaming-platform :global(.prose .pc) {
    --flow-space: calc(var(--space-xl) * 2);
  }
</style>
